%%%%%%%%%%%%%%%% Define Document Layout %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand{\section}[1]{\vskip.15in\noindent\textbf{#1}}
\newcounter{sitzung}
\renewcommand{\thesitzung}{\arabic{sitzung}}

\newcommand{\Sitzung}[3]{%
  \refstepcounter{sitzung}% increment counter (and allow referencing)
    \label{ses:\thesitzung}% automatically create label like ses:1, ses:2, ...
  \par\medskip\noindent
  \textsc{Sitzung \thesitzung \dotfill #1}\par
  \noindent{\color{darkgreen}{\Rectangle}} {#2}\par
  \noindent{\color{darkgreen}{\Rectangle}} {#3}\par
  \medskip
}




